---
import HTML from "./icons/HTML.astro";
import CSS from "./icons/CSS.astro";
import NodeJS from "./icons/NodeJS.astro";
import Angular from "./icons/Angular.astro";
import AWS from "./icons/AWS.astro";
import Bootstrap from "./icons/Bootstrap.astro";
import Python from "./icons/Python.astro";
import Spring from "./icons/Spring.astro";
import Tailwind from "./icons/Tailwind.astro";
import Flask from "./icons/Flask.astro";
import AstroF from "./icons/AstroF.astro";

const TAGS = {
  HTML: {
    name: "HTML",
    class: "bg-[#e95a27]/70 text-white",
    icon: HTML,
  },
  CSS: {
    name: "CSS",
    class: "bg-[#2862f0] text-white",
    icon: CSS,
  },
  NodeJS: {
    name: "NodeJS",
    class: "bg-[#3F873F] text-white",
    icon: NodeJS,
  },
  Angular: {
    name: "Angular",
    class: "bg-[#6C00F5] text-white",
    icon: Angular,
  },
  AWS: {
    name: "AWS",
    class: "bg-[#262626] text-white",
    icon: AWS,
  },
  Bootstrap: {
    name: "Bootstrap",
    class: "bg-[#190d39] text-white",
    icon: Bootstrap,
  },
  Python: {
    name: "Python",
    class: "bg-[#387EB8] text-white",
    icon: Python,
  },
  Spring: {
    name: "Spring",
    class: "bg-[#24441b] text-white",
    icon: Spring,
  },
  Tailwind: {
    name: "Tailwind",
    class: "bg-[#38bdf8] text-white",
    icon: Tailwind,
  },
  Flask: {
    name: "Flask",
    class: "bg-[#4c4c4c] text-white",
    icon: Flask
  },
  Astro: {
    name: "Astro",
    class: "bg-[#f041ff], text-white",
    icon: AstroF
  },
};

const PROJECTS = [
  {
    title: "Insta Scraper - An Instagram Scraping tool",
    description:
      "A personal passion project. It is an Instagram scraper that downloads posts from a target profile and generates markdown output with embedded images and OCR-extracted text (Project is in V1.1 MVP and still needs some future updates).",
    link: "https://github.com/L0cksat/InstaScraper",
    image: "./projects/InstaScraper.webp",
    tags: [TAGS.Python, TAGS.Flask, TAGS.HTML, TAGS.Tailwind],
  },
  {
    title: "Quick Growth Audit Chatbot - Clean & Media",
    description:
      "This is a chatbot specification for a WhatsApp-first lead capture tool that generates and delivers a PDF growth audit. Project under development (available in EN & ES).",
    link: "https://cleanandgreenmedia.com/",
    email: "mailto:ryan@cleanandgreenmedia.com",
    image: "./projects/QuickGrowthAudit.webp",
    tags: [TAGS.Angular, TAGS.CSS, TAGS.NodeJS, TAGS.AWS],
  },

  {
    title: "Final Course Project - Evaluty",
    description:
      "Evaluty is a web application designed to democratize access to real estate valuation, allowing any user to obtain a property price estimate without costs or intermediaries. I was part of the development team (Python) (Available in ES only for the moment).",
    link: "https://github.com/L0cksat/TFG-Evaluador-Precios-Viviendas",
    image: "./projects/Evaluty.webp",
    tags: [TAGS.Angular, TAGS.Bootstrap, TAGS.Python, TAGS.Spring],
  },

  {
    title: "DnD Website - World of Erasia",
    description:
      "This a website I created to host the lore of my DnD game world called World of Erasia. I also have the audio of the sessions uploaded here too.",
    link: "https://l0cksat.github.io/worldoferasia.com/characters.html",
    image: "./projects/WorldOfErasia.webp",
    tags: [TAGS.HTML, TAGS.CSS],
  },

  {
    title: "Website Rolf G. Karlsson Photography",
    description:
      "A website for my father-in-law Rolf Karlsson for his bird photography. The website is still under construction and is bare bones. Update coming soon!",
    link: "https://l0cksat.github.io/Website_Rolf_Karlsson/index.html",
    github: "https://github.com/L0cksat/Website_Rolf_Karlsson",
    image: "./projects/rolf-karlsson.webp",
    tags: [TAGS.Astro, TAGS.CSS, TAGS.Tailwind],
  },
];
---

{
  PROJECTS.map(({ image, title, description, link, email, tags }) => (
    <article>
      <h3 class="text-2xl font-semibold text-blue-200 mb-2">{title}</h3>
      <p class="text-lg text-pretty mb-4">{description}</p>
      <div class="flex flex-col items-start">
        <a href={link} target="_blank" class="project-link text-sm text-pretty text-blue-300 mb-6">View project here</a>
      {email ? <a href={email} target="_blank" class="email-link text-sm text-pretty text-blue-300">For reference, contact Ryan Menzies here</a> : null}
      </div>
      <ul class="flex gap-x-2 flex-row mb-2 mt-8">
        {tags.map((tag) => (
          <li>
            <span
              class={`tech-pill flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 items-center`}
            >
              <tag.icon class="size-6" />
              {tag.name}
            </span>
          </li>
        ))}
      </ul>
      <img
        class="rounded shadow-2xl shadow-white/25 mb-5"
        src={image}
        alt={`Captura de pantalla del proyecto ${image}`}
      />
    </article>
  ))
}
